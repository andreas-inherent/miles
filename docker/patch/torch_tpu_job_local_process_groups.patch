diff --git a/tests/distributed/job_local_process_group_test.py b/tests/distributed/job_local_process_group_test.py
new file mode 100644
index 000000000..5024c7032
--- /dev/null
+++ b/tests/distributed/job_local_process_group_test.py
@@ -0,0 +1,190 @@
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Tests two jobs that share one TPU slice through TORCH_TPU_JOB_DEVICE_IDS.
+
+Every process starts the TPU runtime for the whole slice and joins one
+slice-sized process group. Each job then runs its own `torch.distributed`
+world on its half of the slice: its default group and subgroups are formed
+among the job's processes only, so the two jobs create different groups in a
+different order. Point-to-point transfers between the jobs use the slice group.
+"""
+
+import datetime
+import os
+import signal
+
+from absl.testing import absltest
+import torch
+from torch import distributed as dist
+import torch.multiprocessing as mp
+from torch_tpu._internal.distributed import multiprocessing
+from torch_tpu._internal.distributed import spmd_util
+from torch_tpu._internal.distributed import tpu_distributed
+from torch_tpu._internal.utils import test_utils as utils
+from tests import seed_test_utils
+from tests.distributed import distributed_utils
+
+_SLICE_SIZE = 8
+_JOB_SIZE = 4
+_TIMEOUT = datetime.timedelta(seconds=120)
+# Groups of each job, as job ranks. Job 0 creates only the pairs; job 1 creates
+# the strided pairs first and then the pairs, so the jobs create a different
+# number of groups in a different order.
+_PAIRS = [[0, 1], [2, 3]]
+_STRIDED = [[0, 2], [1, 3]]
+_LAYOUTS_BY_JOB = ([_PAIRS], [_STRIDED, _PAIRS])
+
+
+def _barrier(store: dist.Store, name: str) -> None:
+  """Blocks until all `_SLICE_SIZE` processes reach the barrier `name`."""
+  if store.add(f"{name}:count", 1) == _SLICE_SIZE:
+    store.set(f"{name}:done", "1")
+  store.wait([f"{name}:done"])
+
+
+def _make_layout(job_rank: int, layout: list[list[int]]):
+  """Creates every group of `layout` on every job rank; returns this rank's."""
+  groups = [dist.new_group(ranks=ranks) for ranks in layout]
+  for ranks, group in zip(layout, groups):
+    if job_rank in ranks:
+      return group, ranks
+  raise AssertionError(f"job rank {job_rank} is in no group of {layout}")
+
+
+def run_two_jobs_on_one_slice() -> None:
+  """Runs a 4-process job on each half of an 8-device slice."""
+  slice_rank = int(os.environ["RANK"])
+  assert int(os.environ["WORLD_SIZE"]) == _SLICE_SIZE
+  signal.alarm(300)  # A hang is the failure mode under test.
+  slice_store = dist.TCPStore(
+      os.environ["MASTER_ADDR"],
+      int(os.environ["MASTER_PORT"]),
+      _SLICE_SIZE,
+      is_master=slice_rank == 0,
+      timeout=_TIMEOUT,
+  )
+  # The jobs are defined by devices, so bring up the TPU to learn this
+  # process's device before creating any process group.
+  torch.zeros(1, device="tpu").cpu()
+  device_id = int(tpu_distributed.global_device_id())
+  job = device_id // _JOB_SIZE
+  job_device_ids = list(range(job * _JOB_SIZE, (job + 1) * _JOB_SIZE))
+  job_rank = job_device_ids.index(device_id)
+  peer_device_id = (device_id + _JOB_SIZE) % _SLICE_SIZE
+  # Read when the first process group is created.
+  os.environ["TORCH_TPU_JOB_DEVICE_IDS"] = ",".join(map(str, job_device_ids))
+
+  # The slice group comes first and defines the slice's world ranks.
+  slice_pg = tpu_distributed.create_process_group(
+      dist.PrefixStore("slice", slice_store),
+      slice_rank,
+      _SLICE_SIZE,
+      _TIMEOUT,
+  )
+  slice_store.set(f"slice_rank_of_device:{device_id}", str(slice_rank))
+
+  # Each job's world. Both jobs share the root store on purpose: their groups
+  # must not collide in it.
+  dist.init_process_group(
+      backend="tpu_dist",
+      store=dist.PrefixStore(f"job{job}", slice_store),
+      rank=job_rank,
+      world_size=_JOB_SIZE,
+      timeout=_TIMEOUT,
+  )
+  assert dist.get_world_size() == _JOB_SIZE
+
+  x = torch.tensor([1.0, float(device_id)], device="tpu")
+  dist.all_reduce(x)
+  utils.assert_close(
+      x.cpu(), torch.tensor([float(_JOB_SIZE), float(sum(job_device_ids))])
+  )
+  gathered = torch.empty(_JOB_SIZE, device="tpu")
+  dist.all_gather_into_tensor(
+      gathered, torch.tensor([float(device_id)], device="tpu")
+  )
+  utils.assert_close(
+      gathered.cpu(), torch.tensor([float(d) for d in job_device_ids])
+  )
+
+  # Group k of a job's last layout runs k + 1 all-reduces; no other job takes
+  # part.
+  group, ranks = None, None
+  for layout in _LAYOUTS_BY_JOB[job]:
+    group, ranks = _make_layout(job_rank, layout)
+  group_index = _PAIRS.index(ranks)
+  y = torch.tensor([float(device_id)], device="tpu")
+  for _ in range(group_index + 1):
+    dist.all_reduce(y, group=group)
+  member_sum = float(sum(job_device_ids[r] for r in ranks))
+  utils.assert_close(
+      y.cpu(), torch.tensor([member_sum * len(ranks) ** group_index])
+  )
+
+  # A program that combines the job's world and a pair runs on the job's
+  # devices, with the pair's all-reduce tiled over the job's pairs.
+  @torch.compile(backend="tpu", fullgraph=True)
+  @spmd_util.spmd_safe
+  def mixed(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    dist.all_reduce(a)
+    dist.all_reduce(b, group=group)
+    return a + b
+
+  utils.assert_close(
+      mixed(torch.ones(4, device="tpu"), torch.ones(4, device="tpu")).cpu(),
+      torch.full((4,), float(_JOB_SIZE + len(ranks))),
+  )
+
+  # Job 0 sends to the process on the same position of job 1 over the slice
+  # group.
+  peer_slice_rank = int(
+      slice_store.get(f"slice_rank_of_device:{peer_device_id}")
+  )
+  if job == 0:
+    payload = torch.full((8, 128), float(device_id), device="tpu")
+    slice_pg.send([payload], peer_slice_rank, 0).wait()
+  else:
+    received = torch.empty((8, 128), device="tpu")
+    slice_pg.recv([received], peer_slice_rank, 0).wait()
+    utils.assert_close(
+        received.cpu(), torch.full((8, 128), float(peer_device_id))
+    )
+
+  # The slice group still runs collectives over every process.
+  z = torch.tensor([float(device_id)], device="tpu")
+  work = slice_pg.allreduce([z], dist.AllreduceOptions())
+  if work is not None:
+    work.wait()
+  utils.assert_close(
+      z.cpu(), torch.tensor([float(sum(range(_SLICE_SIZE)))])
+  )
+
+  torch.accelerator.synchronize()
+  dist.destroy_process_group()
+  # Keep slice rank 0's store server alive until every process is done.
+  _barrier(slice_store, "finished")
+
+
+class JobLocalProcessGroupTest(seed_test_utils.MultiProcessRepeatableTest):
+
+  def test_two_jobs_on_one_slice(self):
+    distributed_utils.dist_run(
+        nproc_per_node=_SLICE_SIZE, fn=run_two_jobs_on_one_slice
+    )
+
+
+if __name__ == "__main__":
+  mp.set_start_method("spawn")
+  multiprocessing.handle_test_main(absltest.main)
