+absl::StatusOr<DeviceGroupList> ProcessGroupTpu::GatherJobLocalSubgroups(
+    absl::Span<const int64_t> job_device_ids) {
+  const auto& topo = WorldTopology();
+  const int64_t job_size = job_device_ids.size();
+  TT_RET_CHECK(job_size % size_ == 0, error::kInvalidArgument)
+      << "process group size (" << size_ << ") must divide the job size ("
+      << job_size << ", from " << kTorchTpuJobDeviceIdsEnvVar << ")";
+  // The gather runs in job-rank space: job rank j is the process on device
+  // job_device_ids[j].
+  DeviceGroup job_to_world_rank(job_size);
+  DeviceGroup job_to_topo_order(job_size);
+  int64_t job_rank = -1;
+  for (int64_t j = 0; j < job_size; ++j) {
+    const auto it = absl::c_find(topo.rank_to_device_id, job_device_ids[j]);
+    TT_RET_CHECK(it != topo.rank_to_device_id.end(), error::kInvalidArgument)
+        << kTorchTpuJobDeviceIdsEnvVar << " lists device " << job_device_ids[j]
+        << ", which is not in the slice " << ToString(topo.rank_to_device_id);
+    job_to_world_rank[j] = it - topo.rank_to_device_id.begin();
+    job_to_topo_order[j] = topo.rank_to_topo_order[job_to_world_rank[j]];
+    if (job_device_ids[j] == addressable_device_id_) {
+      job_rank = j;
+    }
+  }
+  TT_RET_CHECK(job_rank >= 0, error::kInvalidArgument)
+      << "this process's device " << addressable_device_id_ << " is not in "
+      << kTorchTpuJobDeviceIdsEnvVar << " " << ToString(job_device_ids);
+
+  // The node-local store is off in jobs (see GetNodeLocalStore), and the key
+  // scope names the job so that jobs sharing a root store do not collide.
+  const std::string gather_id =
+      absl::StrCat("job", job_device_ids[0], ":",
+                   next_job_subgroup_gather_id.fetch_add(1));
+  DeviceGroup member_job_ranks;
+  DeviceGroupList subgroup_job_ranks;
+  TT_RETURN_IF_ERROR(GatherSubgroupsViaNodeLocalStore(
+      store_.get(), /*local_store=*/nullptr, /*local_rank=*/0,
+      /*local_world_size=*/1, rank_, size_, job_rank, job_to_world_rank,
+      job_to_topo_order, gather_id, member_job_ranks, subgroup_job_ranks))
+      << "; with " << kTorchTpuJobDeviceIdsEnvVar
+      << " set, a process group smaller than the slice may hold only this "
+         "job's processes, and its layout must partition the job";
+
+  member_world_ranks_.clear();
+  for (int64_t j : member_job_ranks) {
+    member_world_ranks_.push_back(job_to_world_rank[j]);
+  }
+  std::vector<DeviceGroup> subgroups;
+  for (const DeviceGroup& group : subgroup_job_ranks.groups()) {
+    DeviceGroup& world_group = subgroups.emplace_back();
+    for (int64_t j : group) {
+      world_group.push_back(job_to_world_rank[j]);
+    }
+  }
+  return DeviceGroupList(std::move(subgroups), /*normalize=*/false);
+}
